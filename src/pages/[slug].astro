    background:
      linear-gradient(to top, #0c0b0af5 0%, #0c0b0a88 43%, #0c0b0a00 78%),
      linear-gradient(to bottom, #0c0b0abf, #0c0b0a00 32%),
      linear-gradient(to right, #0c0b0a66, #0c0b0a00 78%);
  }
