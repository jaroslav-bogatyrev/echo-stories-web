---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '@/layouts/Layout.astro';
import FestivalList from '@/components/FestivalList.astro';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  // Filter out locked projects - they should not have their own pages
  return projects
    .filter(project => !project.data.locked)
    .map(project => {
      const slug = project.id.replace('/index', '');
      return {
        params: { slug },
        props: { project, slug },
      };
    });
}

const { project, slug } = Astro.props;
const base = import.meta.env.BASE_URL;

// Read synopsis files from paths defined in frontmatter
let synopsisEn = '';
let synopsisCz = '';

if (project.data.synopsis) {
  const projectDir = path.join(process.cwd(), 'src/content/projects', slug);
  
  if (project.data.synopsis.en) {
    const synopsisEnPath = path.join(projectDir, project.data.synopsis.en);
    if (fs.existsSync(synopsisEnPath)) {
      synopsisEn = fs.readFileSync(synopsisEnPath, 'utf-8');
    }
  }
  
  if (project.data.synopsis.cz) {
    const synopsisCzPath = path.join(projectDir, project.data.synopsis.cz);
    if (fs.existsSync(synopsisCzPath)) {
      synopsisCz = fs.readFileSync(synopsisCzPath, 'utf-8');
    }
  }
}

// All project images (used for stills and laurels)
const allProjectImages = import.meta.glob<{ default: ImageMetadata }>('/src/content/projects/**/*.{jpg,jpeg,png,svg,webp}', { eager: true });

// Load still images dynamically
const stills = project.data.stills ? await Promise.all(
  project.data.stills.map(async (still) => {
    try {
        const images = allProjectImages;
        const imagePath = `/src/content/projects/${slug}/${still.src.replace('./', '')}`;
        const imageModule = images[imagePath];
        return {
          image: imageModule?.default,
          alt: still.alt,
          caption: still.caption,
        };
    } catch (e) {
      return null;
    }
  })
).then(results => results.filter((r): r is { image: ImageMetadata; alt: string; caption?: string } => r !== null && r.image !== undefined)) : [];

const festivals = (project.data.festivals || []).map(festival => ({
  ...festival,
  image: festival.laurel
    ? allProjectImages[`/src/content/projects/${slug}/${festival.laurel.replace('./', '')}`]?.default
    : undefined,
}));

// Load poster if defined
const posterImage = project.data.poster
  ? allProjectImages[`/src/content/projects/${slug}/${project.data.poster.replace('./', '')}`]?.default ?? null
  : null;

// Get all projects for navigation, excluding locked ones
const allProjects = await getCollection('projects');
const sortedProjects = allProjects
  .filter(p => !p.data.locked) // Filter out locked projects
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const currentIndex = sortedProjects.findIndex(f => f.id === project.id);

// Find previous non-locked project (wrap around to end if at beginning)
let prevProject = null;
if (sortedProjects.length > 1) {
  const prevIndex = currentIndex > 0 ? currentIndex - 1 : sortedProjects.length - 1;
  prevProject = sortedProjects[prevIndex];
}

// Find next non-locked project (wrap around to beginning if at end)
let nextProject = null;
if (sortedProjects.length > 1) {
  const nextIndex = currentIndex < sortedProjects.length - 1 ? currentIndex + 1 : 0;
  nextProject = sortedProjects[nextIndex];
}

// Create structured data for Movie
const movieStructuredData = {
  "@context": "https://schema.org",
  "@type": "Movie",
  "name": project.data.title.en,
  "alternateName": project.data.title.cz || undefined,
  "description": project.data.logline?.en || synopsisEn.substring(0, 200),
  "dateCreated": project.data.year.toString(),
  "genre": project.data.category.join(', '),
  "duration": project.data.duration || undefined,
  "inLanguage": "en",
  "productionCompany": {
    "@type": "Organization",
    "name": "Echo Stories"
  },
  "countryOfOrigin": {
    "@type": "Country",
    "name": "Czech Republic"
  }
};

const pageDescription = project.data.logline?.en ||
  `${project.data.title.en} - ${project.data.category.join(', ')} film by Echo Stories. ${synopsisEn.substring(0, 150)}...`;

// Determine the OG image: prefer poster, then first still, then main project image
const mainImage = allProjectImages[`/src/content/projects/${slug}/${project.data.image.replace('./', '')}`]?.default;
const ogImage = posterImage?.src
  || (stills.length > 0 ? stills[0].image.src : undefined)
  || mainImage?.src;
const projectsUrl = `${base}#film-reel`;
const mastheadPosition = slug === 'night-games' ? '70% 50%' : 'center';
---

<Layout
  title={`${project.data.title.en} - Echo Stories Film Project`}
  description={pageDescription}
  image={ogImage}
  type="article"
  cinematicHeader={Boolean(mainImage)}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(movieStructuredData)} />

  <article>
    <header class:list={['project-masthead relative isolate flex flex-col justify-end', mainImage && 'project-masthead-image bg-neutral-950 text-[#f7f2e9]']}>
      {mainImage && (
        <>
          <Image src={mainImage} alt="" class="absolute inset-0 -z-10 h-full w-full object-cover" style={{ objectPosition: mastheadPosition }} widths={[640, 960, 1440, 1920]} sizes="(max-width: 767px) 125vh, 100vw" loading="eager" fetchpriority="high" />
          <div class="project-wash absolute inset-0 -z-10" aria-hidden="true"></div>
        </>
      )}
      <div class="editorial-shell pb-8 pt-10 md:pb-12">
        <a href={projectsUrl} class="mb-6 inline-flex min-h-9 items-center gap-2 text-sm underline decoration-stone-400 underline-offset-4 hover:decoration-current"><span aria-hidden="true">←</span> Back to projects</a>
        <p class:list={['editorial-label mb-2', mainImage && 'project-masthead-label']}>
          {project.data.status === 'in postproduction' ? 'Post-production' : project.data.status}
        </p>
        <h1 class="editorial-title max-w-4xl font-serif">{project.data.title.en}</h1>
        {project.data.title.cz && <p class="mt-2 font-serif text-xl italic opacity-80 md:text-2xl">{project.data.title.cz}</p>}
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-85">
          <span class="capitalize">{project.data.category.join(', ')}</span>
          <span aria-hidden="true">·</span>
          <span>{project.data.year}</span>
          {project.data.duration && <><span aria-hidden="true">·</span><span>{project.data.duration}{project.data.category.includes('series') ? ' / ep.' : ''}</span></>}
          {project.data.category.includes('series') && project.data.episodes && <><span aria-hidden="true">·</span><span>{project.data.episodes} ep.</span></>}
          {project.data.category.includes('series') && project.data.seasons && <><span aria-hidden="true">·</span><span>{project.data.seasons} seasons</span></>}
        </p>
        {project.data.logline && (
          <p class="mt-3 max-w-2xl text-base md:text-lg">
            {project.data.logline.en}
            {project.data.logline.cz && <span class="italic"> / {project.data.logline.cz}</span>}
          </p>
        )}
      </div>
    </header>

    <div class="editorial-shell pt-10 md:pt-14">
    <h2 class="mb-6 font-serif text-3xl">Synopsis</h2>
    {posterImage ? (
      <!-- WITH poster: 2-col grid for poster + synopsis -->
      <div class="md:grid md:grid-cols-[180px_1fr] md:gap-x-12 md:items-start mb-12">
        <div class="mb-6 md:mb-0">
          <button type="button" id="poster-btn" class="hidden md:block group cursor-zoom-in w-full rounded border border-gray-300 dark:border-gray-600 overflow-hidden" aria-label="View poster full size">
            <Image src={posterImage} alt={`${project.data.title.en} poster`} class="w-full shadow-lg transition-transform duration-300 group-hover:scale-105" />
          </button>
        </div>
        <div>
          <button type="button" id="poster-btn-mobile" class="block group cursor-zoom-in mb-8 md:hidden rounded border border-gray-300 dark:border-gray-600 overflow-hidden w-32" aria-label="View poster full size">
            <Image src={posterImage} alt={`${project.data.title.en} poster`} class="w-full shadow-lg transition-transform duration-300 group-hover:scale-105" />
          </button>
          <div class="prose prose-lg dark:prose-invert max-w-none md:grid md:grid-cols-2">
            {synopsisEn && (
              <div class="mb-6 md:mb-0 md:pr-8">
                <p class="editorial-label">English</p>
                <div class="whitespace-pre-wrap">{synopsisEn}</div>
              </div>
            )}
            {synopsisCz && (
              <div class="md:border-l md:border-gray-200 dark:md:border-gray-700 md:pl-8">
                <p class="editorial-label">Czech</p>
                <div class="whitespace-pre-wrap">{synopsisCz}</div>
              </div>
            )}
          </div>
        </div>
      </div>
    ) : (
      <!-- WITHOUT poster: synopsis spans full width -->
      <div class="prose prose-lg dark:prose-invert max-w-none mb-12 md:grid md:grid-cols-2">
        {synopsisEn && (
          <div class="mb-6 md:mb-0 md:pr-8">
            <p class="editorial-label">English</p>
            <div class="whitespace-pre-wrap">{synopsisEn}</div>
          </div>
        )}
        {synopsisCz && (
          <div class="md:border-l md:border-gray-200 dark:md:border-gray-700 md:pl-8">
            <p class="editorial-label">Czech</p>
            <div class="whitespace-pre-wrap">{synopsisCz}</div>
          </div>
        )}
      </div>
    )}

    <!-- Credits / Support / Pitching / Selection -->
    {(() => {
      const productionRoles = ['producer', 'co-producer', 'executive producer', 'associate producer'];
      const allCredits = project.data.credits;
      const half = Math.ceil(allCredits.length / 2);
      const leftCredits = allCredits.slice(0, half);
      const rightCredits = allCredits.slice(half);

      const renderCreditItem = (credit: any, i: number, list: any[]) => {
        const isProduction = productionRoles.includes(credit.role.toLowerCase());
        const prevIsNonProduction = i > 0 && !productionRoles.includes(list[i - 1].role.toLowerCase());
        return (
          <div class={isProduction && prevIsNonProduction ? 'mt-5' : ''}>
            <dt class="inline font-medium">{credit.role}:</dt>
            <dd class="inline ml-2 text-gray-700 dark:text-gray-300">{credit.name}</dd>
          </div>
        );
      };

      const creditsDl = (
        <div class="md:grid md:grid-cols-2">
          <dl class="space-y-1 mb-6 md:mb-0 md:pr-8">
            {leftCredits.map((credit, i) => renderCreditItem(credit, i, leftCredits))}
          </dl>
          {rightCredits.length > 0 && (
            <dl class="space-y-1 border-t border-gray-200 dark:border-gray-700 pt-4 md:border-t-0 md:pt-0 md:border-l md:border-gray-200 dark:md:border-gray-700 md:pl-8">
              {rightCredits.map((credit, i) => renderCreditItem(credit, i, rightCredits))}
            </dl>
          )}
        </div>
      );

      if (posterImage) {
        // WITH poster: [180px | 1fr] label+content grid
        return (
          <div class="md:grid md:grid-cols-[180px_1fr] md:gap-x-12 md:gap-y-10 md:items-start mb-12">
            <div class="mb-2 md:mb-0"><h2 class="font-serif text-2xl leading-none">Credits</h2></div>
            <div>{creditsDl}</div>

            {project.data.support && project.data.support.length > 0 && (
              <>
                <div class="mt-8 mb-2 md:mt-0 md:mb-0"><h2 class="font-serif text-2xl leading-none">Support</h2></div>
                <ul class="list-disc list-inside space-y-1 text-gray-700 dark:text-gray-300">
                  {project.data.support.map(org => <li>{org}</li>)}
                </ul>
              </>
            )}
            {project.data.pitching && project.data.pitching.length > 0 && (
              <>
                <div class="mt-8 mb-2 md:mt-0 md:mb-0"><h2 class="font-serif text-2xl leading-none">Development & Pitching</h2></div>
                <ul class="space-y-1 text-gray-700 dark:text-gray-300">
                  {project.data.pitching.map(event => (
                    <li>
                      <span>{event.name}</span>
                      {event.year && <span class="text-gray-500"> ({event.year})</span>}
                      {event.award && <span class="italic"> – <span class="inline-block">🏆</span> {event.award}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {festivals.length > 0 && (
              <>
                <div class="mt-8 mb-2 md:mt-0 md:mb-0"><h2 id="festivals" class="font-serif text-2xl leading-none">Festivals</h2></div>
                <FestivalList festivals={festivals} />
              </>
            )}
          </div>
        );
      } else {
        // WITHOUT poster: full-width layout, divider aligns with synopsis
        return (
          <div class="mb-12 space-y-10">
            <div>
              <h2 class="font-serif text-2xl leading-none mb-4">Credits</h2>
              {creditsDl}
            </div>
            {project.data.support && project.data.support.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl leading-none mb-4">Support</h2>
                <ul class="list-disc list-inside space-y-1 text-gray-700 dark:text-gray-300">
                  {project.data.support.map(org => <li>{org}</li>)}
                </ul>
              </div>
            )}
            {project.data.pitching && project.data.pitching.length > 0 && (
              <div>
                <h2 class="font-serif text-2xl leading-none mb-4">Development & Pitching</h2>
                <ul class="space-y-1 text-gray-700 dark:text-gray-300">
                  {project.data.pitching.map(event => (
                    <li>
                      <span>{event.name}</span>
                      {event.year && <span class="text-gray-500"> ({event.year})</span>}
                      {event.award && <span class="italic"> – <span class="inline-block">🏆</span> {event.award}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {festivals.length > 0 && (
              <div>
                <h2 id="festivals" class="font-serif text-2xl leading-none mb-4">Festivals</h2>
                <FestivalList festivals={festivals} />
              </div>
            )}
          </div>
        );
      }
    })()}

    <!-- Links -->
    {project.data.links && (project.data.links.instagram || project.data.links.facebook || project.data.links.website) && (
      <section class="editorial-rule mb-12 border-t pt-10">
        <h2 class="mb-4 font-serif text-2xl">Links</h2>
        <div class="flex items-center gap-4">
          {project.data.links.instagram && (
            <a
              href={project.data.links.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors"
              aria-label="Instagram"
            >
              <svg class="w-6 h-6 shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span class="text-base font-medium">@{project.data.links.instagram.match(/instagram\.com\/([^?/]+)/)?.[1] ?? ''}</span>
            </a>
          )}
          {project.data.links.facebook && (
            <a
              href={project.data.links.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors"
              aria-label="Facebook"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {project.data.links.website && (
            <a
              href={project.data.links.website}
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors underline"
            >
              {project.data.links.websiteText || project.data.links.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}
            </a>
          )}
        </div>
      </section>
    )}

    <!-- Video -->
    {project.data.video && (
      <div class="editorial-rule mb-12 border-t pt-10">
        <h2 class="mb-5 font-serif text-3xl">Video</h2>
        {project.data.video.provider === 'youtube' && project.data.video.id && (
          <div class="aspect-video rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <iframe
              width="100%"
              height="100%"
              src={`https://www.youtube.com/embed/${project.data.video.id}`}
              title="Video player"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
              class="border-0"
            ></iframe>
          </div>
        )}
        {project.data.video.provider === 'vimeo' && project.data.video.id && (
          <div class="aspect-video rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden">
            <iframe
              src={`https://player.vimeo.com/video/${project.data.video.id}${project.data.video.hash ? `?h=${project.data.video.hash}` : ''}`}
              width="100%"
              height="100%"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              class="border-0"
            ></iframe>
          </div>
        )}
        {project.data.video.provider === 'direct' && project.data.video.url && (
          <video controls class="w-full">
            <source src={project.data.video.url} type="video/mp4" />
          </video>
        )}
      </div>
    )}

    <!-- Stills Gallery -->
    {stills && stills.length > 0 && (
      <section class="editorial-rule mb-12 border-t pt-10">
        <h2 class="mb-5 font-serif text-3xl">Stills</h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {stills.map((still, index) => {
            const isPortrait = still.image && still.image.height > still.image.width;
            return (
              <button
                type="button"
                data-gallery-index={index}
                class="relative w-full overflow-hidden md:cursor-pointer group rounded-lg border border-gray-200 dark:border-gray-700"
                style={`aspect-ratio: ${isPortrait ? '2/3' : '16/9'}`}
              >
                <Image
                  src={still.image}
                  alt={still.alt}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                  widths={[400, 600, 800]}
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                />
                {still.caption && (
                  <div class="absolute bottom-0 left-0 right-0 px-3 py-2">
                    <p class="text-white/90 text-xs leading-snug bg-black/50 backdrop-blur-sm rounded px-2 py-1 inline-block">{still.caption}</p>
                  </div>
                )}
              </button>
            );
          })}
        </div>
      </section>
    )}

    <!-- Gallery Modal -->
    <div id="gallery-modal" class="hidden fixed inset-0 z-50 bg-black bg-opacity-95">
      <button
        id="close-gallery"
        class="absolute top-4 right-4 text-white text-4xl hover:text-gray-300 z-10"
        aria-label="Close"
      >
        ×
      </button>
      
      <button
        id="prev-image"
        class="hidden md:block absolute left-4 top-1/2 -translate-y-1/2 text-white text-6xl hover:text-gray-300"
        aria-label="Previous"
      >
        ‹
      </button>
      
      <button
        id="next-image"
        class="hidden md:block absolute right-4 top-1/2 -translate-y-1/2 text-white text-6xl hover:text-gray-300"
        aria-label="Next"
      >
        ›
      </button>
      
      <div class="w-full h-full flex items-center justify-center p-4">
        <img
          id="gallery-image"
          src=""
          alt=""
          class="max-w-full max-h-full object-contain"
        />
      </div>
      
      <div id="gallery-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white text-lg">
      </div>

      <div id="gallery-caption" class="absolute bottom-12 left-0 right-0 px-16 text-center hidden">
        <span class="inline-block bg-black/50 text-white/90 text-sm px-3 py-1.5 rounded backdrop-blur-sm"></span>
      </div>
    </div>

    <script is:inline define:vars={{ stills }}>
      // @ts-nocheck
      const modal = document.getElementById('gallery-modal');
      const galleryImage = document.getElementById('gallery-image');
      const galleryCounter = document.getElementById('gallery-counter');
      const galleryCaption = document.getElementById('gallery-caption');
      const closeBtn = document.getElementById('close-gallery');
      const prevBtn = document.getElementById('prev-image');
      const nextBtn = document.getElementById('next-image');
      const galleryButtons = document.querySelectorAll('[data-gallery-index]');

      let currentIndex = 0;
      
      function showImage(index) {
        if (!stills || stills.length === 0) return;
        
        currentIndex = (index + stills.length) % stills.length;
        const still = stills[currentIndex];
        
        if (still && still.image && still.image.src) {
          galleryImage.src = still.image.src;
          galleryImage.alt = still.alt || '';
          galleryCounter.textContent = `${currentIndex + 1} / ${stills.length}`;
          if (still.caption) {
            galleryCaption.querySelector('span').textContent = still.caption;
            galleryCaption.classList.remove('hidden');
          } else {
            galleryCaption.querySelector('span').textContent = '';
            galleryCaption.classList.add('hidden');
          }
        }
      }
      
      galleryButtons.forEach(button => {
        button.addEventListener('click', () => {
          // Не открываем галерею на мобильных (ширина < 768px)
          if (window.innerWidth < 768) return;
          
          const index = parseInt(button.getAttribute('data-gallery-index'));
          modal.classList.remove('hidden');
          showImage(index);
        });
      });

      const posterBtn = document.getElementById('poster-btn');
      const posterBtnMobile = document.getElementById('poster-btn-mobile');

      function openPosterModal(btn) {
        const img = btn.querySelector('img');
        if (!img) return;
        galleryImage.src = img.src;
        galleryImage.alt = img.alt;
        galleryCounter.textContent = '';
        galleryCaption.querySelector('span').textContent = '';
        galleryCaption.classList.add('hidden');
        modal.classList.remove('hidden');
      }

      if (posterBtn) posterBtn.addEventListener('click', () => openPosterModal(posterBtn));
      if (posterBtnMobile) posterBtnMobile.addEventListener('click', () => openPosterModal(posterBtnMobile));

      closeBtn.addEventListener('click', () => {
        modal.classList.add('hidden');
      });
      
      prevBtn.addEventListener('click', () => {
        showImage(currentIndex - 1);
      });
      
      nextBtn.addEventListener('click', () => {
        showImage(currentIndex + 1);
      });
      
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.classList.add('hidden');
        }
      });
      
      document.addEventListener('keydown', (e) => {
        if (!modal.classList.contains('hidden')) {
          if (e.key === 'Escape') {
            modal.classList.add('hidden');
          } else if (e.key === 'ArrowLeft') {
            showImage(currentIndex - 1);
          } else if (e.key === 'ArrowRight') {
            showImage(currentIndex + 1);
          }
        }
      });
    </script>

    <!-- Navigation -->
    <nav class="editorial-rule mt-12 flex justify-between gap-5 border-t pt-8" aria-label="More projects">
      <div>
        {prevProject && (
          <a href={`${base}/${prevProject.id.replace('/index', '')}`.replace(/\/+/g, '/')} class="group flex items-center gap-2 hover:text-gray-600 dark:hover:text-gray-400">
            <span class="text-2xl">←</span>
            <div>
              <div class="text-sm text-gray-500">Previous</div>
              <div class="group-hover:underline">{prevProject.data.title.en}</div>
            </div>
          </a>
        )}
      </div>
      <div class="text-right">
        {nextProject && (
          <a href={`${base}/${nextProject.id.replace('/index', '')}`.replace(/\/+/g, '/')} class="group flex items-center gap-2 hover:text-gray-600 dark:hover:text-gray-400">
            <div>
              <div class="text-sm text-gray-500">Next</div>
              <div class="group-hover:underline">{nextProject.data.title.en}</div>
            </div>
            <span class="text-2xl">→</span>
          </a>
        )}
      </div>
    </nav>
    </div>
  </article>
</Layout>

