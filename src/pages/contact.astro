---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../lib/config';

const base = import.meta.env.BASE_URL;
---

<Layout 
  title="Contact Echo Stories - Film Production Prague"
  description="Get in touch with Echo Stories. Contact producer Iuliia Mamaeva for film collaborations and project inquiries. Based in Prague, Czech Republic."
  showFooter={false}
>
  <div class="editorial-shell py-10 md:py-14">
    <h1 class="sr-only">Contact</h1>
    
    <!-- Producer Profile Section -->
    <div class="editorial-rule mb-9 border-b pb-9 md:mb-12 md:pb-12">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center md:gap-10">
        <!-- Profile Photo -->
        <div class="flex-shrink-0">
          <div class="aspect-square w-40 overflow-hidden rounded-sm bg-[var(--editorial-panel)] md:w-56">
            <img
              src={`${base}/profile.jpg`.replace(/\/+/g, '/')}
              alt="Iuliia Mamaeva - Producer"
              class="w-full h-full object-cover"
              width="224"
              height="224"
            />
          </div>
        </div>

        <!-- Profile Info with Contact Details -->
        <div class="flex-1 space-y-6">
          <div>
            <p class="editorial-label mb-2">Producer</p>
            <h2 class="font-serif text-3xl md:text-4xl">Iuliia Mamaeva</h2>
          </div>

          <div>
            <h3 class="editorial-label mb-2">Email</h3>
            <a
              href={`mailto:${siteConfig.email}`}
              class="break-words text-base underline decoration-gray-400 underline-offset-4 hover:decoration-current"
            >
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Company Address and Information -->
    <div class="grid max-w-3xl gap-x-12 gap-y-8 md:grid-cols-2">
      <!-- Left Column - Company Info -->
      <div>
        <h2 class="editorial-label mb-2">Company Information</h2>
        <div class="space-y-1 text-base text-gray-600 dark:text-gray-400">
          <p class="font-medium text-gray-900 dark:text-gray-100">Echo Film Production s.r.o.</p>
          <p>IČO: 24107514</p>
          <p>DIČ: CZ24107514</p>
        </div>
      </div>

      <!-- Right Column - Address -->
      <div>
        <h2 class="editorial-label mb-2">Address</h2>
        <p class="text-base">Příčná 1892/4, Nové Město</p>
        <p class="text-base">110 00 Praha 1</p>
        <p class="text-base text-gray-600 dark:text-gray-400 mt-1">Czech Republic</p>
      </div>
    </div>
  </div>
</Layout>
