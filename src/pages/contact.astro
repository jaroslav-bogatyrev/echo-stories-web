---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../lib/config';

const base = import.meta.env.BASE_URL;
---

<Layout 
  title="Contact Echo Stories - Film Production Prague"
  description="Get in touch with Echo Stories. Contact producer Iuliia Mamaeva for film collaborations and project inquiries. Based in Prague, Czech Republic."
>
  <div class="max-w-3xl mx-auto px-6 py-12 md:py-16">
    <h1 class="font-display text-3xl md:text-4xl uppercase mb-2 text-ink">Contact</h1>
    <p class="text-sm text-muted mb-12 echo-waves">Get in touch</p>

    <!-- Producer Profile Section -->
    <div class="mb-12 pb-12 section-divider pt-0 mt-0">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <!-- Profile Photo -->
        <div class="flex-shrink-0">
          <div class="w-44 h-44 ink-border overflow-hidden shadow-elevated">
            <img
              src={`${base}/profile.jpg`.replace(/\/+/g, '/')}
              alt="Iuliia Mamaeva - Producer"
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <!-- Profile Info with Contact Details -->
        <div class="flex-1 space-y-5">
          <div>
            <h2 class="font-display text-xl md:text-2xl uppercase mb-1 text-ink">Iuliia Mamaeva</h2>
            <p class="text-sm text-muted">Producer · Founder</p>
          </div>

          <div class="warm-panel">
            <h3 class="text-xs text-muted uppercase font-bold tracking-wider mb-1.5 star-accent">Email</h3>
            <a
              href={`mailto:${siteConfig.email}`}
              class="text-base text-brand-red font-semibold hover:underline transition-colors"
            >
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Company Address and Information -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Left Column - Company Info -->
      <div class="ink-border p-5">
        <h3 class="text-xs text-muted uppercase font-bold tracking-wider mb-3 star-accent">Company Information</h3>
        <div class="space-y-1.5 text-sm text-ink/75">
          <p>
            <span class="font-semibold text-ink">Echo Stories</span> – production label run by:
          </p>
          <p class="text-ink/60">Echo Film Production s.r.o.</p>
          <p>IČO: 24107514</p>
          <p>DIČ: CZ24107514</p>
        </div>
      </div>

      <!-- Right Column - Address -->
      <div class="ink-border p-5">
        <h3 class="text-xs text-muted uppercase font-bold tracking-wider mb-3 star-accent">Address</h3>
        <div class="space-y-1.5 text-sm">
          <p class="text-ink">Příčná 1892/4, Nové Město</p>
          <p class="text-ink">110 00 Praha 1</p>
          <p class="text-muted mt-2">{siteConfig.location}</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
