---
import { siteConfig } from "@/lib/config";
---

<footer class="border-t-[3px] border-ink mt-24 relative">
  <div class="filmstrip mb-6"></div>
  <div class="max-w-7xl mx-auto px-6 py-8">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div>
        <span class="font-display text-sm uppercase tracking-wide text-ink/80">{siteConfig.siteName}</span>
        <p class="text-sm text-muted mt-1">
          {siteConfig.location}
        </p>
      </div>
      <span class="text-brand-yellow text-2xl opacity-50 echo-waves" aria-hidden="true">✦</span>
    </div>
  </div>
</footer>
