---
import { siteConfig } from "@/lib/config";

const base = import.meta.env.BASE_URL;
---

<footer class="mt-24 relative">
  <div class="filmstrip"><span class="text-brand-yellow text-xs opacity-60">✦</span></div>
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
      <div>
        <a href={base} class="font-display text-sm uppercase tracking-wide text-ink/70 hover:text-ink transition-colors">
          {siteConfig.siteName}
        </a>
        <p class="text-xs text-muted mt-1.5">
          {siteConfig.location} · Independent film production
        </p>
      </div>
      <div class="flex items-center gap-4 text-muted text-xs">
        <a href={`${base}/about`.replace(/\/+/g, '/')} class="hover:text-ink transition-colors">About</a>
        <span class="text-ink/20">·</span>
        <a href={`${base}/contact`.replace(/\/+/g, '/')} class="hover:text-ink transition-colors">Contact</a>
        <span class="text-ink/20">·</span>
        <span class="text-brand-yellow/50 tracking-[-0.12em] font-bold">)))</span>
      </div>
    </div>
  </div>
</footer>
