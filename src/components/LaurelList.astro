---
import { Image } from 'astro:assets';

interface Props {
  laurels: { image: ImageMetadata; name: string }[];
  class?: string;
}

const { laurels, class: className } = Astro.props;
---

<ul aria-label="Festival laurels" class:list={['flex flex-wrap items-center gap-x-2 gap-y-1 md:gap-x-3', className]}>
  {laurels.map(laurel => (
    <li><Image src={laurel.image} alt={laurel.name} width={192} loading="eager" fetchpriority="low" class="h-11 w-12 object-contain brightness-0 invert sm:h-14 sm:w-16 lg:h-16 lg:w-20" /></li>
  ))}
</ul>

<script is:inline>
  (() => {
    const list = document.currentScript.previousElementSibling;
    const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
    if (!motion.matches || !list.animate) return;

    list.style.opacity = '0';
    const images = Array.from(list.querySelectorAll('img'));
    Promise.allSettled(images.map(image => image.decode())).then(() => {
      list.style.removeProperty('opacity');
      if (motion.matches) {
        list.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 440,
          easing: 'ease-out',
        });
      }
    });
  })();
</script>
